# Concept Atlas — one file for every service.
# Copy to .env and edit. Real environment variables override these.

# ───────────────────────────── the model behind Ask and Debate ──────────
# Any OpenAI-compatible chat endpoint. The default is the local vLLM server.
ATLAS_VLLM=http://localhost:8000/v1
ATLAS_MODEL=Qwen3.8-27B-TURBO
# Some endpoints require a key; a local vLLM usually does not.
ATLAS_API_KEY=
# The model's context window, in tokens. Attached context is budgeted from it.
ATLAS_MAX_CTX=550000
# Cap the length of one reply. Leave empty for no limit — the model stops when
# it is finished or when the context runs out, which is what you usually want.
ATLAS_MAX_OUTPUT_TOKENS=

# ───────────────────────────────────────────────────────── the services ──
ATLAS_UI_PORT=8788
ATLAS_JASPER=http://127.0.0.1:8790
ATLAS_CHAT=http://127.0.0.1:8793
ATLAS_CHAT_PORT=8793

# ─────────────────────────────────────────────────────────────── search ──
# Let the chat agent search the open web. Readers can still switch it off
# per conversation; this is the ceiling, not the default.
ATLAS_ALLOW_WEB=true
