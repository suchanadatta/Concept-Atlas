[Unit]
Description=Concept Atlas public endpoint (zrok)
After=network-online.target concept-atlas-ui.service
Wants=network-online.target concept-atlas-ui.service

[Service]
Type=simple
WorkingDirectory=/store/shuvam/BMoral
ExecStart=/store/shuvam/BMoral/tools/zrok-share.sh
# A clean SIGTERM is what lets zrok unbind the share; without it the name is
# left occupied and the next start has to sweep it.
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=always
RestartSec=5
StartLimitIntervalSec=0

[Install]
WantedBy=default.target
